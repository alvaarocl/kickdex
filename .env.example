# 🔑 CONFIGURACIÓN DE KICKDEX PRO
# Renombra este archivo a .env e introduce tus llaves reales.

# ── APIs DE MERCADO ───────────────────────────────────────────────────────────
# Consíguela en: https://the-odds-api.com/
THE_ODDS_API_KEY=tu_llave_aqui

# Consíguela en: https://dashboard.api-football.com/
FOOTBALL_API_KEY=tu_llave_aqui

# ── NOTIFICACIONES (TELEGRAM) ──────────────────────────────────────────────────
# Habla con @BotFather en Telegram para conseguir el token.
TELEGRAM_TOKEN=tu_token_aqui
# Habla con @userinfobot para conseguir tu ID.
TELEGRAM_CHAT_ID=tu_id_aqui

# ── BASE DE DATOS ─────────────────────────────────────────────────────────────
# En producción usa PostgreSQL (ej: postgresql://user:pass@host:port/db)
DATABASE_URL=sqlite:///./kickdex.db

# ── FRONTEND ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
